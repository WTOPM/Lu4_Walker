<Window x:Class="WTOPMBot.KeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTOPMBot — Клавиши"
        Width="980"
        MinWidth="860"
        Height="720"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/app.ico"
        ShowInTaskbar="True">
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar only — drag here, NOT over inputs -->
            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Padding="16,10"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="32" Height="28"
                                Style="{StaticResource ChromeButton}"
                                Content="─"
                                ToolTip="Свернуть"
                                Click="MinimizeButton_OnClick"/>
                        <Button Width="32" Height="28"
                                Style="{StaticResource ChromeCloseButton}"
                                Content="✕"
                                ToolTip="Закрыть"
                                Click="CloseButton_OnClick"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/app.ico" Width="20" Height="20" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Клавиши"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  действие на слот панели"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,14,16,8">
                <UniformGrid Columns="3" Rows="1">
                    <Border Margin="0,0,8,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Панель 1" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="F1 — F12" FontSize="11" FontFamily="Segoe UI"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="Panel1Host"/>
                        </DockPanel>
                    </Border>

                    <Border Margin="4,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Панель 2" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="1 — =" FontSize="11" FontFamily="Segoe UI"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="Panel2Host"/>
                        </DockPanel>
                    </Border>

                    <Border Margin="8,0,0,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Панель 3" FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Num 1 — Num *" FontSize="11" FontFamily="Segoe UI"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="Panel3Host"/>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>

            <!-- Settings strip: wraps, never clips inputs -->
            <Border Grid.Row="2"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,8,8"
                                MinWidth="210">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SettingCaption}" Text="Next ×"/>
                                <TextBox x:Name="NextTargetAttemptsBox"
                                         Style="{StaticResource TimingBox}"
                                         Text="3"
                                         ToolTip="Сколько раз жать Next target между таргетами по нику"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,8,8"
                                MinWidth="280">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ApproachNextCheck"
                                          Style="{StaticResource TopmostCheck}"
                                          Content="Next по дороге"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          ToolTip="Пока бежите к таргету по нику и HP полное — жать Next"/>
                                <TextBlock Style="{StaticResource SettingCaption}" Text="каждые"/>
                                <TextBox x:Name="ApproachIntervalBox"
                                         Style="{StaticResource TimingBox}"
                                         Text="1500"
                                         ToolTip="Интервал Next по дороге (мс)"/>
                                <TextBlock Style="{StaticResource SettingCaption}" Text="мс" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                MinWidth="260">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SettingCaption}" Text="Лут ×"/>
                                <TextBox x:Name="LootAttemptsBox"
                                         Style="{StaticResource TimingBox}"
                                         Text="3"
                                         ToolTip="Сколько раз жать Лут при черепе"/>
                                <TextBlock Style="{StaticResource SettingCaption}" Text="каждые" Margin="10,0,8,0"/>
                                <TextBox x:Name="LootIntervalBox"
                                         Style="{StaticResource TimingBox}"
                                         Text="800"
                                         ToolTip="Пауза между нажатиями лута (мс)"/>
                                <TextBlock Style="{StaticResource SettingCaption}" Text="мс" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock x:Name="HintText"
                               Grid.Row="1"
                               Margin="0,0,0,10"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="Ники по кругу · Next × N · дорога Next · труп (череп) → Лут × N."/>

                    <DockPanel Grid.Row="2">
                        <Button DockPanel.Dock="Left"
                                Height="36"
                                MinWidth="88"
                                Padding="14,0"
                                Style="{StaticResource GhostButton}"
                                Content="Сброс"
                                ToolTip="Таргет=3 · Атака=1"
                                Click="ResetDefaultsButton_OnClick"/>
                        <Button DockPanel.Dock="Right"
                                Height="36"
                                MinWidth="120"
                                Padding="18,0"
                                Style="{StaticResource PrimaryToggle}"
                                Content="Сохранить"
                                Click="SaveButton_OnClick"/>
                        <Border/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
