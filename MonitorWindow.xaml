<Window x:Class="WTOPMBot.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTOPMBot — Монитор"
        Width="480"
        MinWidth="420"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/app.ico"
        ShowInTaskbar="True">
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="#2A313C"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,16">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="MonitorTopmostCheck"
                              Style="{StaticResource TopmostCheck}"
                              Content="Поверх"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Checked="MonitorTopmostCheck_OnChanged"
                              Unchecked="MonitorTopmostCheck_OnChanged"/>
                    <Button Width="32" Height="28"
                            Style="{StaticResource ChromeButton}"
                            Content="─"
                            ToolTip="Свернуть"
                            Click="MinimizeButton_OnClick"/>
                    <Button Width="32" Height="28"
                            Style="{StaticResource ChromeCloseButton}"
                            Content="✕"
                            ToolTip="Закрыть"
                            Click="CloseButton_OnClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.ico" Width="22" Height="22" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Монитор"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Pixel probe -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Пробник пикселя"/>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="CoordXBox" Grid.Column="1" Style="{StaticResource FieldBox}" Text="0"/>
                        <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBox x:Name="CoordYBox" Grid.Column="4" Style="{StaticResource FieldBox}" Text="0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="R" FontSize="11" Foreground="#E06C75" Margin="2,0,0,4"/>
                            <TextBox x:Name="ColorRBox" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="—"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="G" FontSize="11" Foreground="#6BCB8B" Margin="2,0,0,4"/>
                            <TextBox x:Name="ColorGBox" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="—"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="B" FontSize="11" Foreground="#6BA3E8" Margin="2,0,0,4"/>
                            <TextBox x:Name="ColorBBox" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="—"/>
                        </StackPanel>
                        <Border x:Name="ColorPreview" Grid.Column="6" Width="48" Height="48"
                                CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Background="#12161C" VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Player bars -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Свои полоски"/>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CP" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#D78E17"/>
                        <Border x:Name="CpTrack" Grid.Column="1" Height="18" CornerRadius="6" Background="#1E242E" ClipToBounds="True" SizeChanged="BarTrack_OnSizeChanged">
                            <Border x:Name="CpFill" HorizontalAlignment="Left" Width="0" Background="#D78E17" CornerRadius="6"/>
                        </Border>
                        <TextBlock x:Name="CpPercentText" Grid.Column="2" Text="—" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HP" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#A13940"/>
                        <Border x:Name="HpTrack" Grid.Column="1" Height="18" CornerRadius="6" Background="#1E242E" ClipToBounds="True" SizeChanged="BarTrack_OnSizeChanged">
                            <Border x:Name="HpFill" HorizontalAlignment="Left" Width="0" Background="#A13940" CornerRadius="6"/>
                        </Border>
                        <TextBlock x:Name="HpPercentText" Grid.Column="2" Text="—" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MP" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4179CE"/>
                        <Border x:Name="MpTrack" Grid.Column="1" Height="18" CornerRadius="6" Background="#1E242E" ClipToBounds="True" SizeChanged="BarTrack_OnSizeChanged">
                            <Border x:Name="MpFill" HorizontalAlignment="Left" Width="0" Background="#4179CE" CornerRadius="6"/>
                        </Border>
                        <TextBlock x:Name="MpPercentText" Grid.Column="2" Text="—" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Target -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Цель"/>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TGT" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#E06C75"/>
                        <Border x:Name="TargetHpTrack" Grid.Column="1" Height="18" CornerRadius="6" Background="#1E242E" ClipToBounds="True" SizeChanged="BarTrack_OnSizeChanged">
                            <Border x:Name="TargetHpFill" HorizontalAlignment="Left" Width="0" Background="#E06C75" CornerRadius="6"/>
                        </Border>
                        <TextBlock x:Name="TargetHpPercentText" Grid.Column="2" Text="—" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#1E242E" CornerRadius="10" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="TargetSelectedDot" Width="8" Height="8" Fill="#5C6675" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TargetSelectedText" Text="Цель: —" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1E242E" CornerRadius="10" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="TargetDeadDot" Width="8" Height="8" Fill="#5C6675" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TargetDeadText" Text="Мёртв: —" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="BarsHintText"
                       FontSize="11"
                       Foreground="#5C6675"
                       TextWrapping="Wrap"
                       Text="Профиль: profiles/player_bars.json"/>
        </StackPanel>
    </ScrollViewer>
    </Border>
</Window>
