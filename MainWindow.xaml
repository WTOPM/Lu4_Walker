<Window x:Class="WTOPMBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTOPMBot"
        Width="420"
        MinWidth="380"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/app.ico">
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="#2A313C"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid Margin="18,12,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="TopmostCheck"
                              Style="{StaticResource TopmostCheck}"
                              Content="Поверх"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Checked="TopmostCheck_OnChanged"
                              Unchecked="TopmostCheck_OnChanged"/>
                    <Button Width="32" Height="28"
                            Style="{StaticResource ChromeButton}"
                            Content="─"
                            ToolTip="Свернуть"
                            Click="MinimizeButton_OnClick"/>
                    <Button Width="32" Height="28"
                            Style="{StaticResource ChromeCloseButton}"
                            Content="✕"
                            ToolTip="Закрыть"
                            Click="CloseButton_OnClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.ico" Width="22" Height="22" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="WTOPMBot"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Процесс" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProcessCombo"
                                  Grid.Column="0"
                                  Height="40"
                                  MaxDropDownHeight="260"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ProcessCombo_OnSelectionChanged"/>
                        <Button x:Name="SaveProcessButton"
                                Grid.Column="2"
                                Width="40" Height="40"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Сохранить процесс по умолчанию"
                                Click="SaveProcessButton_OnClick"
                                Content="★" FontSize="15"/>
                        <Button x:Name="RefreshButton"
                                Grid.Column="4"
                                Width="40" Height="40"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Обновить список"
                                Click="RefreshButton_OnClick"
                                Content="↻" FontSize="16"/>
                    </Grid>

                    <CheckBox x:Name="AutoAttackCheck"
                              Style="{StaticResource TopmostCheck}"
                              Content="Автоатака 3 / 1 / 2"
                              Margin="0,0,0,12"
                              Checked="AutoAttackCheck_OnChanged"
                              Unchecked="AutoAttackCheck_OnChanged"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartButton"
                                Grid.Column="0"
                                Height="44"
                                Style="{StaticResource PrimaryToggle}"
                                Click="StartButton_OnClick"
                                ToolTip="Page Up"
                                Content="Старт  PgUp"/>
                        <Button x:Name="StopButton"
                                Grid.Column="2"
                                Height="44"
                                Style="{StaticResource StopToggle}"
                                Click="StopButton_OnClick"
                                ToolTip="Page Down"
                                Content="Стоп  PgDn"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CaptureButton"
                                Grid.Column="0"
                                Height="44"
                                Padding="12,8"
                                Style="{StaticResource CaptureButton}"
                                Click="CaptureButton_OnClick"
                                Content="Скрин  Ins"/>
                        <Button x:Name="MonitorButton"
                                Grid.Column="2"
                                Height="44"
                                Style="{StaticResource GhostButton}"
                                Click="MonitorButton_OnClick"
                                Content="Монитор"/>
                    </Grid>

                    <Border Margin="0,12,0,0"
                            Background="#12161C"
                            CornerRadius="10"
                            Padding="12,10">
                        <DockPanel>
                            <Ellipse x:Name="StatusDot"
                                     Width="8" Height="8"
                                     Margin="0,3,8,0"
                                     Fill="{StaticResource MutedBrush}"
                                     VerticalAlignment="Top"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Выберите процесс и нажмите Старт"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="HotkeyHintText"
                       Grid.Row="2"
                       Margin="2,10,2,0"
                       FontSize="10"
                       Foreground="#5C6675"
                       TextWrapping="Wrap"
                       Text="PgUp/PgDn · Ins=скрин"/>
        </Grid>
    </Border>
</Window>
